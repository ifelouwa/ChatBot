# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ---------------------------------------------------------------
# Needed when AI_PROVIDER=claude (below).
ANTHROPIC_API_KEY=
# Local (npm run db:local), or a hosted Postgres such as Neon, Supabase or RDS.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# Protects /admin. /admin stays locked until this is set.
ADMIN_PASSWORD=
# Full public address of the site, used for links in owner notifications.
PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider ------------------------------------------------------------
# claude or gemini. Existing chats keep the provider they started with.
AI_PROVIDER=claude

# Claude: claude-opus-5-5 is the default. claude-sonnet-5-5 and claude-haiku-5-5 cost less.
CLAUDE_MODEL=claude-opus-5-5

# Gemini: free key from https://aistudio.google.com/app/apikey
# On the free tier, Google may use chats to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Owner notifications ----------------------------------------------------
# Comma-separated: email, whatsapp, log. "log" prints to the server console.
NOTIFY_CHANNELS=log

# Email through Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Confirmation email to the customer, when they give an address: email, log or off.
# "email" sends through Resend using the settings above. "log" prints it instead.
CUSTOMER_CONFIRMATIONS=log

# WhatsApp Cloud API (Meta). The template must be approved first: see README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=enquiry_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v24.0

# Protects the notification retry job. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Abuse and spending limits (defaults shown) -----------------------------
RATE_LIMIT_PER_IP_PER_10_MIN=20
MAX_TURNS_PER_CONVERSATION=40
MAX_AI_TURNS_PER_DAY=500
# Random text that makes stored IP hashes unguessable.
IP_HASH_SALT=

# Set to 1 only with npm run db:local, which accepts a single connection.
PG_POOL_MAX=
